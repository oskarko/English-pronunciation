    {
      "t": "errors",
      "title": "¡Así no se dice!",
      "title_en": "Don't say it like this",
      "items": [
        {
          "bad": "water → <code>wáter</code> (T explosiva)",
          "good": "<code>wárer</code>",
          "why": "Con T española suena a «váter». Un toque suave, como en «pero».",
          "why_en": "Use a soft tap, not a hard T."
        },
        {
          "bad": "better → <code>bérrer</code> (rr fuerte)",
          "good": "<code>bérer</code>",
          "why": "Es una r <b>simple</b>, un solo toque. Nada de vibrar como en «perro».",
          "why_en": "One single tap, never a trilled rr."
        },
        {
          "bad": "hotel → <code>jourél</code>",
          "good": "<code>joutél</code>",
          "why": "La T empieza la sílaba fuerte (ho-TEL): se queda como T.",
          "why_en": "T starts the stressed syllable, so it stays a T."
        },
        {
          "bad": "Italian → <code>irǽliən</code>",
          "good": "<code>itǽliən</code>",
          "why": "Italy sí lleva toque (<code>írəli</code>), pero Italian no: la fuerza está en TA.",
          "why_en": "Italy has a tap; Italian doesn't."
        },
        {
          "bad": "after → <code>ǽrer</code>",
          "good": "<code>ǽfter</code>",
          "why": "Detrás de una consonante (f) la T no cambia.",
          "why_en": "After a consonant, the T doesn't change."
        },
        {
          "bad": "city → <code>síti</code>",
          "good": "<code>síri</code>",
          "why": "Así lo dice un británico. En Estados Unidos, ¡como Siri!",
          "why_en": "That's British. Americans say it like Siri."
        },
        {
          "bad": "party → <code>pár-ti</code>",
          "good": "<code>párdi</code>",
          "why": "Después de R también hay toque; suena casi como una d suave.",
          "why_en": "After R, the T is a tap too."
        }
      ]
    },
