    {
      "t": "errors",
      "title": "¡Así no se dice!",
      "title_en": "Don't say it like this",
      "items": [
        {
          "bad": "hello → con la jota de «jamón», rascando",
          "good": "<code>jəlóu</code>, solo aire",
          "why": "La jota española rasca la garganta. La H inglesa es un suspiro suave.",
          "why_en": "The English H is just breath, not a scratchy sound."
        },
        {
          "bad": "hotel → <code>outél</code>",
          "good": "<code>joutél</code>",
          "why": "En español la H de hotel es muda; en inglés suena.",
          "why_en": "In English, the H in hotel is pronounced."
        },
        {
          "bad": "hamburger → <code>amburguer</code>",
          "good": "<code>jǽmberguer</code>",
          "why": "Sopla al principio y pon la fuerza en JǼM.",
          "why_en": "Say the H and stress the first syllable."
        },
        {
          "bad": "hour → <code>jáuer</code>",
          "good": "<code>áuer</code>",
          "why": "Hour es del club de la H muda: suena igual que our.",
          "why_en": "Hour has a silent H. It sounds like «our»."
        },
        {
          "bad": "who → <code>wuu</code>",
          "good": "<code>juu</code>",
          "why": "En who suena la H y se calla la W.",
          "why_en": "In who, you say the H, not the W."
        },
        {
          "bad": "honest → <code>jónest</code>",
          "good": "<code>ánist</code>",
          "why": "H muda, y la o suena a.",
          "why_en": "Silent H, and the o sounds like «a»."
        },
        {
          "bad": "hungry → <code>ángri</code>",
          "good": "<code>jángri</code>",
          "why": "¡Sin H dices angry, enfadado!",
          "why_en": "Without the H, you say «angry»."
        }
      ]
    },
