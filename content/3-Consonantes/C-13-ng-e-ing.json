    {
      "t": "errors",
      "title": "¡Así no se dice!",
      "title_en": "Don't say it like this",
      "items": [
        {
          "bad": "sing → <code>sing-g</code> (con g)",
          "good": "<code>sing</code>",
          "why": "La g no suena: la lengua se queda pegada atrás y el sonido se apaga por la nariz.",
          "why_en": "Don't release a g at the end."
        },
        {
          "bad": "thing → <code>zin</code>",
          "good": "<code>zing</code>",
          "why": "Con la punta arriba dices thin (delgado). Lengua atrás, como en «tengo».",
          "why_en": "With a front n, thing becomes thin."
        },
        {
          "bad": "going → <code>goíng</code>",
          "good": "<code>góuing</code>",
          "why": "El -ING nunca lleva el golpe: GÓU-ing, casi «góuen».",
          "why_en": "Never stress the -ing."
        },
        {
          "bad": "singer → <code>sínguer</code>",
          "good": "<code>síng-er</code>",
          "why": "Singer viene de sing: sin g. (Finger sí la lleva: <code>fínguer</code>.)",
          "why_en": "Singer has no g sound; finger does."
        },
        {
          "bad": "English → <code>inglés</code>",
          "good": "<code>ínglish</code>",
          "why": "La fuerza va delante: ÍN-glish. Aquí la g sí suena.",
          "why_en": "Stress the first syllable; here the g is pronounced."
        },
        {
          "bad": "ping-pong → <code>pimpón</code>",
          "good": "<code>píngpang</code>",
          "why": "Nada de m ni n: dos NG con la lengua atrás.",
          "why_en": "Two back NG sounds, not m or n."
        },
        {
          "bad": "young → <code>yong</code>",
          "good": "<code>iáng</code>",
          "why": "Y suave (mapa C-10), la o suena a corta y NG sin g.",
          "why_en": "Soft Y, short a sound, and NG with no g."
        }
      ]
    },
