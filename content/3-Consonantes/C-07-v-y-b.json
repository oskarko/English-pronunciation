          "bad": "vote → <code>bout</code>",
          "good": "<code>vout</code>",
          "why": "Boat es barco. ¡Votar se dice con dientes!",
          "why_en": "Boat is a different word."
        },
        {
          "bad": "seven → <code>sében</code>",
          "good": "<code>sévən</code>",
          "why": "En medio de la palabra también hay que morder el labio.",
          "why_en": "Keep the V in the middle of the word."
        },
        {
          "bad": "five → <code>faif</code>",
          "good": "<code>faiv</code>",
          "why": "Termina con zumbido, no con soplido: la V vibra, la F no.",
          "why_en": "End with a buzz, not just air."
        },
        {
          "bad": "love → <code>laf</code> o <code>la</code>",
          "good": "<code>lav</code>",
          "why": "No te comas la V final ni la conviertas en F.",
          "why_en": "Don't drop the final V or turn it into F."
