    {
      "t": "errors",
      "title": "¡Así no se dice!",
      "title_en": "Don't say it like this",
      "items": [
        {
          "bad": "a cup of tea → <code>ei kap of tii</code>",
          "good": "<code>ə kápə tíi</code>",
          "why": "A y of son ratones: «ə». Solo cup y tea van fuertes.",
          "why_en": "«A» and «of» are weak. Only «cup» and «tea» are strong."
        },
        {
          "bad": "to school → <code>tuu skúul</code>",
          "good": "<code>tə skúul</code>",
          "why": "To delante de consonante es «tə», rapidito. «Tuu» solo al final o con énfasis.",
          "why_en": "Before a consonant, «to» is «tə»."
        },
        {
          "bad": "Thanks for coming → <code>zænks for káming</code>",
          "good": "<code>zænks fer káming</code>",
          "why": "For va flojito, «fer». Dicho fuerte suena igual que four (cuatro).",
          "why_en": "Strong «for» sounds like «four»."
        },
        {
          "bad": "you and me → <code>iu ǽnd mi</code>",
          "good": "<code>iu ən míi</code>",
          "why": "And casi siempre es «ən»: la d desaparece y la a se relaja.",
          "why_en": "«And» is usually just «ən»."
        },
        {
          "bad": "Where are you from? → <code>wérer iə frəm</code>",
          "good": "<code>wérer iə frám</code>",
          "why": "Al final de la frase, from va fuerte: «fram».",
          "why_en": "At the end of a sentence, «from» is strong."
        },
        {
          "bad": "call her → <code>kol jer</code>",
          "good": "<code>kóler</code>",
          "why": "En medio de la frase, la h de her, him y have se cae y todo se pega.",
          "why_en": "The h of «her» drops and the words link."
        },
        {
          "bad": "I can swim → <code>ai kǽn swím</code>",
          "good": "<code>ai kən swím</code>",
          "why": "Can afirmativo es débil, «kən». Si lo dices fuerte, ¡pueden entender can't! (mapa H-08)",
          "why_en": "Positive «can» is weak; a strong one may sound like «can't»."
        }
      ]
    },
