    {
      "t": "errors",
      "title": "¡Así no se dice!",
      "title_en": "Don't say it like this",
      "items": [
        {
          "bad": "won't → <code>want</code>",
          "good": "<code>wount</code>",
          "why": "Want es «quiero» y won't es «no lo haré». ¡Dirías lo contrario!",
          "why_en": "«Want» and «won't» mean very different things."
        },
        {
          "bad": "we're → <code>wer</code>",
          "good": "<code>wir</code>",
          "why": "Wer es were (estábamos). We're lleva una i: «wir».",
          "why_en": "«We're» has an «i» sound; «were» doesn't."
        },
        {
          "bad": "Yes, I'm.",
          "good": "Yes, I am. → <code>iés, ai ǽm</code>",
          "why": "Al final de una respuesta corta, nunca se contrae.",
          "why_en": "Never contract at the end of a short answer."
        },
        {
          "bad": "I do not like it. (sin querer)",
          "good": "I don't like it. → <code>ai dount láikit</code>",
          "why": "Sin contraer suena enfadado o muy formal. Al hablar, contrae.",
          "why_en": "Without contractions you sound angry or formal."
        },
        {
          "bad": "don't → <code>don</code>",
          "good": "<code>dount</code>",
          "why": "Lleva el diptongo «ou» (como go) y una t final suave.",
          "why_en": "Don't has the «ou» sound of «go»."
        },
        {
          "bad": "isn't → <code>isnt</code> (una sílaba)",
          "good": "<code>ísənt</code>",
          "why": "Isn't, doesn't y didn't tienen dos sílabas: ÍS-ənt, DÁS-ənt, DÍD-ənt.",
          "why_en": "Isn't, doesn't and didn't have two syllables."
        },
        {
          "bad": "I should of called.",
          "good": "I should've called. → <code>ai shúrəv kóld</code>",
          "why": "Suena igual que «should of», pero es should have. ¡Hasta los americanos se equivocan al escribirlo!",
          "why_en": "It sounds like «should of», but it's «should have»."
        }
      ]
    },
