    {
      "t": "errors",
      "title": "¡Así no se dice!",
      "title_en": "Don't say it like this",
      "items": [
        {
          "bad": "E → <code>e</code>",
          "good": "<code>ii</code>",
          "why": "La E inglesa suena como nuestra I, larga.",
          "why_en": "E sounds like a long Spanish i."
        },
        {
          "bad": "I → <code>i</code>",
          "good": "<code>ai</code>",
          "why": "La I es «¡ay!». Si dices «i», entienden E.",
          "why_en": "Say «ai», or they'll hear E."
        },
        {
          "bad": "G → «ge»",
          "good": "<code>yii</code>",
          "why": "G acaba en ii; J acaba en ei.",
          "why_en": "G ends in «ii», J in «ei»."
        },
        {
          "bad": "H → <code>áche</code>",
          "good": "<code>eich</code>",
          "why": "Nada de «ache»: <code>eich</code>.",
          "why_en": "H is «eich»."
        },
        {
          "bad": "Y → «i griega»",
          "good": "<code>wai</code>",
          "why": "La Y suena como why.",
          "why_en": "Y sounds like «why»."
        },
        {
          "bad": "Z → <code>zéta</code>",
          "good": "<code>sii</code> 🐝",
          "why": "En EE. UU. es zee (zed es británico), con una s que zumba.",
          "why_en": "American Z is «zee»."
        }
      ]
    },
