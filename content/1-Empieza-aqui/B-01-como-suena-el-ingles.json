          "es": "hotel",
          "icon": "🏨"
        },
        {
          "en": "chocolate",
          "say": "cháklət",
          "es": "chocolate",
          "icon": "🍫"
        },
        {
          "en": "hamburger",
          "say": "jǽmberguer",
          "es": "hamburguesa",
          "icon": "🍔"
        },
        {
          "en": "tomato",
          "say": "təméirou",
          "es": "tomate",
          "icon": "🍅"
        },
        {
          "en": "animal",
          "say": "ǽniməl",
          "es": "animal",
          "icon": "🐾"
        }
      ]
    },
    {
